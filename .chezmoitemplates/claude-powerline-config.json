{{- /* Shared claude-powerline config; each profile passes its label background
       as .label_bg. Rendered as literal text rather than merged with
       mergeOverwrite/toPrettyJson, because claude-powerline orders segments by
       key order and toPrettyJson sorts keys. The env segment reads
       CLAUDE_PROFILE, which the statusLine command in settings.json sets. */ -}}
{
  "theme": "custom",
  "colors": {
    "custom": {
      "env": { "bg": "{{ .label_bg }}", "fg": "#ffffff", "bold": true }
    }
  },
  "display": {
    "style": "powerline",
    "charset": "unicode",
    "autoWrap": true,
    "lines": [
      {
        "segments": {
          "env": { "enabled": true, "variable": "CLAUDE_PROFILE", "prefix": "" },
          "model": { "enabled": true },
          "git": {
            "enabled": true,
            "showRepoName": true,
            "showSha": false,
            "showAheadBehind": false
          },
          "context": { "enabled": true, "percentageMode": "used" },
          "block": { "enabled": true, "displayStyle": "text" },
          "weekly": { "enabled": true, "displayStyle": "text" }
        }
      }
    ]
  }
}
