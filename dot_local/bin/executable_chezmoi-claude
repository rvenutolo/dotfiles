#!/usr/bin/env bash

# Run chezmoi against the second instance that manages ~/.config/claude, e.g.
# `chezmoi-claude diff`, `chezmoi-claude edit <target>`, `chezmoi-claude verify`.

set -Eeuo pipefail
IFS=$'\n\t'
trap 'printf "error: line %s (exit %s): %s\n" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# @description Run chezmoi with the second instance's config file, passing all
#   arguments through. Refuses when the config file is absent: chezmoi does not
#   fail on a missing --config file, it silently falls back to the default
#   dotfiles source and $HOME, so the command would act on the wrong repo.
# @arg $@ arguments forwarded to chezmoi
# @stderr error naming the missing config file
# @exitcode 1 the config file does not exist
# @exitcode * otherwise the exit status of chezmoi (this function execs it)
function main() {
  local -r config="${XDG_CONFIG_HOME:-${HOME}/.config}/chezmoi-claude/chezmoi.toml"
  if [[ ! -f "${config}" ]]; then
    printf 'chezmoi-claude: config file not found: %s\n' "${config}" >&2
    printf 'Run chezmoi apply in the dotfiles repo to create it.\n' >&2
    exit 1
  fi
  exec chezmoi --config "${config}" "$@"
}

main "$@"
