{{- /*
  App-written state living beside managed config in an exact_ directory. exact_
  removes every unmanaged entry, so runtime files the app owns must be ignored
  here or they are silently deleted on apply. State *directories* are handled
  instead by a managed-but-not-exact `<dir>/.keep` in the source tree; this list
  is only for loose files. See the `exact_foo/` bullet in CLAUDE.md.
*/}}
.config/docker/.token_seed
.config/docker/.token_seed.lock
.config/lite-xl/session.lua
.config/lite-xl/user_settings.lua

{{- /* Skip terminal-editor .desktop files when the binary isn't installed. */}}
{{- if not (lookPath "hx") }}
dot_local/share/applications/hx.desktop
{{- end }}
{{- if not (lookPath "nano") }}
dot_local/share/applications/nano.desktop
{{- end }}
{{- if not (lookPath "nvim") }}
dot_local/share/applications/nvim.desktop
{{- end }}
{{- /* Work-only targets: the GHES MCP server and the work shell profile, which carries the GHES hostname. */}}
{{- if not .is_work }}
.config/claude/work/.claude.json
.config/profile-local-work.sh
{{- end }}

{{- /*
  CI has no access to the real age identity, so anything that calls decrypt
  can't render there. Skip the known decrypt-dependent targets when running
  under CI (is_ci, from .chezmoi.toml.tmpl) so the render-verify workflow can
  still validate every other template.
*/}}
{{- if and (hasKey . "is_ci") .is_ci }}
.config/claude/work/.claude.json
.config/topgrade/topgrade.toml
.etc/docker-daemon.json
.etc/network-manager-aws-vpn-dns-fix
{{- end }}
