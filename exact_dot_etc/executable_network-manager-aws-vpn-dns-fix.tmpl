#!/usr/bin/env bash
# /etc/NetworkManager/dispatcher.d/99-vpn-dns-fix
#
# Split DNS for the AWS VPN. The AWS client pushes `~.` onto tun0, which sends
# every lookup to the work resolver. When tun0 comes up, replace `~.` with the
# work routing domains and drop tun0 as a default DNS route, so only work names
# reach the work resolver and everything else uses the active network's DNS.
#
# The list includes `~elb.amazonaws.com`: internal work names CNAME to internal
# ELB names, and those chases must stay on the VPN resolver because some
# networks' resolvers (AT&T residential gateways) strip A records pointing into
# RFC 1918 space.

set -Eeuo pipefail
IFS=$'\n\t'
trap 'echo "error: line ${LINENO} (exit $?): ${BASH_COMMAND}" >&2' ERR

# Work routing domains, one per line. Kept in an age-encrypted file rather than
# inline, since this repo is public.
readonly -a WORK_DOMAINS=(
{{- range (include ".work-vpn-dns-domains.age" | decrypt | splitList "\n") }}
{{- if trim . }}
  {{ trim . | squote }}
{{- end }}
{{- end }}
)
# The AWS client's catch-all routing domain; its arrival marks the client's push
# as complete, and it is what this script removes.
readonly CATCH_ALL='~.'
# Broader than the `~elb.amazonaws.com` in WORK_DOMAINS: it would send all AWS
# lookups, public ones included, to the work resolver, so it is dropped if present.
readonly LEGACY_DOMAIN='~amazonaws.com'
# Up to ~5s of polling at 0.1s intervals.
readonly MAX_ATTEMPTS=50

# @description Header-free read of tun0's current routing domains.
#   'resolvectl domain tun0' hard-wraps long domain lists across multiple
#   physical lines (at ~72 columns, even when piped), so a per-line parse would
#   silently drop every domain past the wrap. Fold the output back into a single
#   line first, then strip the "Link N (tun0): " header. This can never leak the
#   header in as a bogus domain, and an empty list yields zero domains.
# @noargs
# @stdout One routing domain per line.
function read_domains() {
  resolvectl domain tun0 \
    | tr '\n' ' ' \
    | sed --regexp-extended 's/^Link [0-9]+ \([^)]*\): //' \
    | tr ' ' '\n' \
    | grep --invert-match '^$' || true
}

# @description Succeed when the first argument equals any of the remaining ones.
# @arg $1 needle
# @arg $@ haystack
function contains() {
  local -r needle="$1"
  shift
  local item
  for item in "$@"; do
    if [[ "${item}" == "${needle}" ]]; then
      return 0
    fi
  done
  return 1
}

# @description NetworkManager dispatcher entry point.
# @arg $1 interface name NetworkManager brings up/down
# @arg $2 action the dispatcher event (e.g. up, vpn-up)
function main() {
  local -r interface="$1"
  local -r action="$2"

  if [[ "${interface}" != 'tun0' ]]; then
    exit 0
  fi

  case "${action}" in
    up | vpn-up) ;;
    *)
      exit 0
      ;;
  esac

  if ! command -v resolvectl > /dev/null 2>&1; then
    echo 'resolvectl not found' >&2
    exit 1
  fi

  local -a domains=()
  local domain

  # Idempotent: already rewritten (no catch-all, every work domain present).
  mapfile -t domains < <(read_domains)
  if ! contains "${CATCH_ALL}" "${domains[@]}"; then
    local missing=0
    for domain in "${WORK_DOMAINS[@]}"; do
      if ! contains "${domain}" "${domains[@]}"; then
        missing=1
      fi
    done
    if ((missing == 0)); then
      exit 0
    fi
  fi

  # Race guard: the AWS --up script sets tun0 domains asynchronously. Wait for
  # its catch-all so the read-modify-write below can never lose pushed domains.
  local attempt=1
  while ! contains "${CATCH_ALL}" "${domains[@]}"; do
    if ((attempt >= MAX_ATTEMPTS)); then
      # Fail-safe: never write a list built from a push we did not see.
      echo "tun0 never received ${CATCH_ALL}; leaving its DNS domains unchanged" >&2
      exit 0
    fi
    sleep 0.1
    attempt=$((attempt + 1))
    mapfile -t domains < <(read_domains)
  done

  # Keep what the client pushed (search domains), minus the catch-all, the
  # legacy domain and anything re-added below; then append the work list.
  local -a new_domains=()
  for domain in "${domains[@]}"; do
    if [[ "${domain}" == "${CATCH_ALL}" || "${domain}" == "${LEGACY_DOMAIN}" ]] \
      || contains "${domain}" "${WORK_DOMAINS[@]}"; then
      continue
    fi
    new_domains+=("${domain}")
  done
  new_domains+=("${WORK_DOMAINS[@]}")

  resolvectl domain tun0 "${new_domains[@]}"
  resolvectl default-route tun0 false
  resolvectl flush-caches
}

main "$@"
