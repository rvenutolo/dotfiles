{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':timezone(America/New_York)'],
  schedule: ['after 2am on saturday'],
  // Only these managers — everything else in this repo is chezmoi target
  // state, not dependency manifests.
  enabledManagers: ['github-actions', 'pre-commit', 'custom.regex'],
  'pre-commit': { enabled: true },
  packageRules: [
    {
      // Low-risk GitHub Actions updates automerge once CI is green;
      // minor/major stay manual. External SHA bumps are always manual
      // (unreviewed third-party code), as are pre-commit rev bumps with the
      // single narrow exception in the rule below.
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['pin', 'digest', 'patch'],
      automerge: true,
    },
    {
      // renovatebot/pre-commit-hooks cuts a release for every Renovate
      // release — several per week — and the only hook used from it is
      // renovate-config-validator, which parses .github/renovate.json5 and
      // exits. Automerging patch+minor keeps the validator in step with the
      // Renovate that actually runs this repo instead of generating a review
      // chore every Saturday. Majors stay manual: they can tighten schema
      // validation and break the lint job.
      //
      // Deliberate, narrow exception to "pre-commit rev bumps are manual":
      // matchPackageNames scopes it to this one repo (the pre-commit manager
      // sets both depName and packageName to the bare owner/repo), and
      // matchDepTypes: ['repository'] scopes it to `rev:` bumps rather than a
      // hook's additional_dependencies (depType pre-commit-node).
      matchManagers: ['pre-commit'],
      matchDepTypes: ['repository'],
      matchPackageNames: ['renovatebot/pre-commit-hooks'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
    },
  ],
  customManagers: [
    {
      // Matches the "# renovate:" hook comments in .chezmoiexternal.toml.tmpl
      // (see CLAUDE.md, externals pinning policy). currentDigest is the
      // 40-hex commit SHA embedded in the url line below each comment.
      customType: 'regex',
      managerFilePatterns: ['/^\\.chezmoiexternal\\.toml\\.tmpl$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<packageName>\\S+) branch=(?<currentValue>\\S+)[\\s\\S]*?url = [^\\n]*?(?<currentDigest>[0-9a-f]{40})',
      ],
      datasourceTemplate: '{{datasource}}',
    },
  ],
}
