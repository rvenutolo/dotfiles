{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':timezone(America/New_York)'],
  // Surfaces everything Renovate is holding back — pending minimumReleaseAge
  // updates, rate-limited PRs, anything it decided not to propose. Without it,
  // "Renovate proposed nothing" and "Renovate never ran" look identical from
  // inside the repo.
  dependencyDashboard: true,
  // Only these managers — everything else in this repo is chezmoi target
  // state, not dependency manifests.
  enabledManagers: ['github-actions', 'pre-commit', 'custom.regex'],
  'pre-commit': { enabled: true },
  // Everything Renovate opens automerges — GitHub Actions bumps of every
  // update type, pre-commit `rev:` bumps, and third-party external SHA bumps
  // alike, as soon as CI is green. `ignoreTests` is left at its default of
  // false, so Renovate refuses to merge a branch whose status checks have not
  // passed. The lint + render jobs exercise the actions and re-render every
  // host, so a bump that breaks the repo does not merge itself. GitHub Actions
  // and pre-commit updates additionally wait out the 7-day quarantine below
  // before their PR is even opened.
  //
  // There is no `schedule`: PRs open, rebase and merge whenever Renovate runs.
  // `main` requires branches to be up to date, so a weekly window would let
  // queued PRs drain only a few rebases per week.
  //
  // This deliberately replaces the earlier policy of hand-reviewing external
  // SHA bumps, pre-commit revs, and GitHub Actions digest re-points. The last
  // of those is the one that needed a replacement rather than just a decision:
  // on an action already pinned to a SHA, a digest-only bump means the
  // upstream tag was repointed to different code at the same version — the
  // mutable-tag substitution SHA pinning exists to catch.
  //
  // The quarantine below does NOT hold that class. Renovate ages a `digest`
  // update against the release timestamp of the matched version, and that
  // version shipped months ago, so a repointed tag clears the window
  // instantly. Renovate's own docs are explicit: "Datasources whose timestamps
  // reflect when the matched version was first released (such as github-tags
  // for digest-pinned GitHub Actions) cannot detect re-published content."
  //
  // So the gate is .dev/check-pin-digest-provenance.sh, run by the
  // pin-provenance CI job on every PR. It diffs each action pin and each
  // pre-commit `rev:` against the base ref and fails any SHA that moved while
  // its version label did not. CI green is a precondition of automerge, so
  // that check is what actually blocks the repoint from merging itself.
  automerge: true,
  // GitHub's native auto-merge: the `protect-main` ruleset's required checks
  // are what it waits on, so a PR merges the moment they pass rather than on
  // Renovate's next run. Renovate's own `renovate/stability-days` check is
  // not required, which is safe only because no PR here is opened while that
  // check would still be pending — see the externals rule below.
  platformAutomerge: true,
  // Soak time: adopt only code that has been public for a week. Complements
  // SHA pinning rather than duplicating it — pinning secures the version you
  // are ON (an immutable ref cannot be repointed under you); this secures the
  // version you are MOVING TO. Under the default `internalChecksFilter:
  // 'strict'`, Renovate does not open the PR until the release has aged, so
  // nothing sits open through the window. Externals are exempt (below).
  //
  // `minimumReleaseAgeBehaviour` is left at its default of
  // `timestamp-required`, which fails closed: an update whose datasource
  // reports no release timestamp is never treated as stable, so it can never
  // automerge. That is only safe because every datasource in use here reports
  // one — github-tags and pre-commit's github-tags both do, and the externals
  // use `github-digest` (which derives a timestamp from the commit date)
  // rather than `git-refs` (which reports nothing). If an external ever stops
  // receiving PRs, check that its `# renovate:` comment still says
  // `datasource=github-digest` before looking anywhere else — a silent stall
  // is exactly what a missing timestamp looks like from in here, and the
  // Dependency Dashboard is where it shows up.
  minimumReleaseAge: '7 days',
  packageRules: [
    {
      // Externals get no soak time. They track a moving branch, so at any
      // moment the datasource offers exactly one candidate: that branch's head
      // commit. There is no older version to fall back to, so every new
      // upstream commit restarts the clock, and an active upstream never ages
      // a week. Under `strict` such an external would never get a PR; under
      // `flexible` its PR would sit open indefinitely. Either way the
      // quarantine starves exactly the externals that change most.
      // Scoped to this manager on purpose: github-actions and pre-commit
      // resolve real version lists and keep the 7-day quarantine.
      matchManagers: ['custom.regex'],
      minimumReleaseAge: '0 days',
    },
  ],
  customManagers: [
    {
      // Matches the "# renovate:" hook comments in .chezmoiexternal.toml.tmpl
      // (see CLAUDE.md, externals pinning policy). currentDigest is the
      // 40-hex commit SHA embedded in the url line below each comment.
      customType: 'regex',
      managerFilePatterns: ['/^\\.chezmoiexternal\\.toml\\.tmpl$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<packageName>\\S+) branch=(?<currentValue>\\S+)[\\s\\S]*?url = [^\\n]*?(?<currentDigest>[0-9a-f]{40})',
      ],
      datasourceTemplate: '{{datasource}}',
    },
  ],
}
