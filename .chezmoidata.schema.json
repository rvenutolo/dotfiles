{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chezmoidata",
  "type": "object",
  "additionalProperties": false,
  "required": ["hostnames", "paths", "git_repos", "editors", "browsers", "terminals", "pagers", "age", "checksums", "weather"],
  "properties": {
    "hostnames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personal_desktop", "personal_laptop", "work_laptop"],
      "properties": {
        "personal_desktop": { "$ref": "#/$defs/hostname" },
        "personal_laptop": { "$ref": "#/$defs/hostname" },
        "work_laptop": { "$ref": "#/$defs/hostname" }
      }
    },
    "paths": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/homeRelativePath" }
    },
    "git_repos": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z_]+$" }
    },
    "editors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "visual"],
      "properties": {
        "text": { "$ref": "#/$defs/programChain" },
        "visual": { "$ref": "#/$defs/programChain" }
      }
    },
    "browsers": { "$ref": "#/$defs/programChain" },
    "terminals": { "$ref": "#/$defs/programChain" },
    "pagers": { "$ref": "#/$defs/programChain" },
    "age": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_key"],
      "properties": {
        "public_key": { "type": "string", "pattern": "^age1[0-9a-z]{58}$" }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crypt_age_key", "crypt_id_ed25519", "crypt_id_ed25519_pub"],
      "properties": {
        "crypt_age_key": { "$ref": "#/$defs/sha256" },
        "crypt_id_ed25519": { "$ref": "#/$defs/sha256" },
        "crypt_id_ed25519_pub": { "$ref": "#/$defs/sha256" }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wttr_city"],
      "properties": {
        "wttr_city": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "hostname": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "homeRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(^|/)\\.\\.($|/))(?!.*~)\\S+(?<!/)$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "programChain": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/programEntry" }
    },
    "programEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bin"],
      "properties": {
        "bin": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
        "flatpak_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$" },
        "args": { "type": "string", "minLength": 1 }
      }
    }
  }
}
